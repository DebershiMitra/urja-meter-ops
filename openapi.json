    "/api/v1/spatial/nearby": {
      "get": {
        "tags": [
          "Spatial & Location"
        ],
        "summary": "Find Meters Near GPS Coordinates",
        "description": "Calculates geodesic distance using the Haversine formula and returns smart meters within a radial distance (km) of specified latitude/longitude.",
        "operationId": "find_nearby_meters_api_v1_spatial_nearby_get",
        "parameters": [
          {
            "name": "latitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 90.0,
              "minimum": -90.0,
              "description": "Center GPS Latitude",
              "title": "Latitude"
            },
            "description": "Center GPS Latitude"
          },
          {
            "name": "longitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 180.0,
              "minimum": -180.0,
              "description": "Center GPS Longitude",
              "title": "Longitude"
            },
            "description": "Center GPS Longitude"
          },
          {
            "name": "radius_km",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 100.0,
              "minimum": 0.01,
              "description": "Radius boundary in kilometers",
              "default": 2.0,
              "title": "Radius Km"
            },
            "description": "Radius boundary in kilometers"
          },
          {
            "name": "limit",
